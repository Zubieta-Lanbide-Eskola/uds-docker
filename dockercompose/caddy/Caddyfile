
{$DOMAIN_NAME} {

    @notStatic {
        not path /uds/res/
    }
    root * /media
    handle {
        reverse_proxy @notStatic udsbroker:8000 
    }
    handle /uds/res/* {
        uri strip_prefix /uds/res
        file_server
    }
    handle /guacamole/* {
        reverse_proxy @notStatic guacamole:8080
    }
}
